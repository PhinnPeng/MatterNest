{
  "name": "matter-nest",
  "version": "0.0.0",
  "private": true,
  "description": "MatterNest 一期：律所风险事项 → 案件全生命周期（待 P1-20 确认仓库名）",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev --port 3777",
    "gallery": "node agent-work/gallery-server.mjs",
    "canon:check": "node agent-work/canon-check.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node tools/db-check.mjs",
    "deploy:check": "node deploy/verify-deploy.mjs",
    "keys:gen": "node tools/keys.mjs gen",
    "keys:check": "node tools/keys.mjs check",
    "board:drift": "node tools/board-drift.mjs",
    "branches:merged": "node tools/branch-merged.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node tools/migrate.mjs --migrate-only",
    "db:seed": "node tools/migrate.mjs --seed-only",
    "smoke": "node tools/run-smokes.mjs",
    "verify": "pnpm format:check && node tools/encoding-check.mjs && pnpm lint && pnpm typecheck && pnpm test && node tools/lint-guard/check.mjs && pnpm anchors:check && pnpm canon:check && pnpm deploy:check",
    "anchors:check": "node agent-work/verify-anchors.mjs",
    "prepare": "node tools/install-githooks.mjs",
    "verify:all": "pnpm verify && cross-env MN_DB_CONFIRM=dev_matternest pnpm db:check && pnpm smoke",
    "storage:setup": "node --experimental-strip-types tools/storage-setup.ts",
    "storage:check": "node --experimental-strip-types tools/storage-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@paca-ai/paca-mcp": "0.19.0",
    "@stinsky/xray": "^0.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-devtools-mcp": "1.11.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.64.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@tanstack/react-query": "^5.104.0",
    "antd": "^6.6.5",
    "croner": "10.0.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "0.45.3",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "zod": "^4.6.5"
  }
}
