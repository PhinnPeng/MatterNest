# MatterNest 环境变量清单（W0-1 骨架：只给键名与占位值，真实值属 W0-5）
# 复制为 .env 使用；.env 已被 .gitignore 排除。
# 规则：任何密钥都不入库、不进镜像（技术选型 §6）。
# ⚠ `MN_` 前缀属 master P1-20 未拍项（命名五条从未回写规格件）；拍定后与本文件一起改，不要一半改一半留。
# ⚠ 真实值只写 .env（已 gitignore），本文件永远留空值。

# --- 数据库（2026-09-27 实测连通）---
# ⚠ 共享 dev 机经 GameViewer 端口映射，连的是【本机回环 127.0.0.1:<本地端口>】，
#   不是映射表「目标地址」那一列的 172.16.70.100 —— 连那个 IP 会全部超时（本仓踩过一次）。
# 实测：127.0.0.1:30432 对 PostgreSQL SSLRequest 握手回 「N」 → 服务真在听；server_version = 16.13。
# 角色与库的命名约定参考同级项目 F:/WorkSpace/SY-AgileIdentity（每项目一个 dev_<项目> 角色 + 同名库）。
PGHOST=127.0.0.1
PGPORT=30432
PGDATABASE=dev_matternest
PGUSER=dev_matternest
PGPASSWORD=
# 连接池设 10，不引入 pgbouncer（技术选型 §12.5）
PG_POOL_MAX=10
# 会话必须固定 UTC。注意：共享机服务端默认 timezone = PRC(+08)，不是 UTC。
# 这条前提**由代码拥有**：建应用角色的路径 `tools/ci-provision-role.mjs` 分权时一并下发
# `ALTER ROLE <应用角色> SET timezone='UTC'`（role 级默认 ⇒ 新连接自动是 UTC，不依赖应用侧
# 记得 SET），而 `db/client.ts` 起池时断言不是 UTC 就抛。手工建过的角色补跑一次那条工具。
# 改回来会怎样、以及版本/编码/日界/回滚的重复自检：`pnpm db:check`（故意不进 verify）。

# --- 对象存储（MinIO）---
# 实测：30090 = S3 API（/minio/health/live 回 200、GET / 回 403 AccessDenied），30091 = MinIO Console（HTML 200）
# ⚠ 本期 Demo **不读写 MinIO**：附件是 W1-10，还没有服务账号（key 留空即"未开通"的正常形态）。
#    留空不影响界面：详情页没有"附件"Tab，而不是放了个坏掉的上传按钮。
MINIO_ENDPOINT=http://127.0.0.1:30090
MINIO_CONSOLE=http://127.0.0.1:30091
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mn-attachments
# 预签名有效期：GET 60s；PUT 由上传流程另算（修订稿 §7.1）
MINIO_PRESIGN_GET_SECONDS=60

# --- 字段加密（修订稿 §6.3）---
# ⚠ 三把密钥都**不要手写**：跑 `node tools/keys.mjs gen`，它会打印值 + 校验值 + 警告。
#    把它输出的**整段**（每把连同上方那行 `# sha256 前 8 位：`）贴到这里，再跑
#    `node tools/keys.mjs check` 核对一遍 —— 那道核对抓的是「字符颠倒」，
#    而字符颠倒长度对、解出的字节数也对，parseKeyMaterial 抓不到。
#    手册：deploy/README.md「三把密钥怎么产出」。
#
# ⚠ 三把必须**互不相同**（NIST SP 800-57 Pt1 R5 §5.2 的 shall）：共用一把意味着
#    拿到它的人一次就同时拿到「解密全部 PII」与「伪造任意会话」。启动期自检会拦。
# ⚠ 一旦填上并启动，就**一直用同一把**。换掉的后果见 deploy/README.md
#    「换密钥前必读」——其中 MN_AES_KEY 那条是**全库 PII 永久不可读**。
# MN_AES_KEY=
MN_HMAC_KEY=
# MN_KEY_VERSION 只是记录用的标签，**不是密钥**，也**不做密钥选择**（一期只有一把钥匙）
MN_KEY_VERSION=1
# 本企业名（逗号分隔可写多个别名）：建案/事项时输入它会提示而不是建档（防呆，F3-5）
MN_OWN_COMPANY_NAMES=

# --- 云之家（口径：我方适配云之家，不改造平台）---
YZJ_APP_ID=
YZJ_APP_SECRET=
YZJ_REDIRECT_URI=
YZJ_STATE_SECRET=
# 域名必须在联调前定死：改域名要重走一次回调登记
PUBLIC_ORIGIN=

# --- 会话凭据 + 多副本两槽（§13.3-3）---
# ⚠ **已裁定一期单副本**（MATT-35，2026-10-13）：下面 `NEXT_SERVER_ACTIONS_ENCRYPTION_KEY`
#    与 `DEPLOYMENT_VERSION` 两个槽在本仓是**空转**——本仓没有 Server Function，
#    加密键无物可解；`deploymentId` 防的是多实例版本错配，单副本没有这个面。
#    它们留在文件里是为了把「多副本要配什么」记在案，不是待办。
#    二期若转多副本，恢复这两项即可（三件套的另一件 = advisory lock，见 `worker/README.md`）。
#
# ⚠ 但 `MN_SESSION_PEPPER` 与"多副本"无关，**不填就直接起不来**：`auth.ts` 的 `pepper()` 缺值即抛，
#    故意不给默认密钥——有默认值等于所有部署共用一把，那还不如不哈希。
#    且自检挂在 `registerNode()` 上（MATT-36）：**缺它 ⇒ server ready 之前 exit 1**，
#    不是等第一个要鉴权的请求才 500。
#    形状：与上面两把同口径（32 字节；43 字符 base64url 或 64 字符 hex）——
#    此前它是三把里唯一只查「非空」的，而它是唯一能造成权限提升的那把。
#    ⚠ 换掉它**必须重启进程**才生效：`pepper()` 是模块级缓存（MATT-36 收紧第 2 项），
#    不重启的话旧 cookie 仍按旧 pepper 校验、新会话也仍用旧 pepper ——
#    也就是 `.env` 显示新值、实际跑的还是旧值。重启后旧会话全部失效（预期行为）。
MN_SESSION_PEPPER=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
DEPLOYMENT_VERSION=

# --- 应用 ---
NODE_ENV=development
LOG_LEVEL=info
