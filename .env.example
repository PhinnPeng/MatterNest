# MatterNest 环境变量清单（W0-1 骨架：只给键名与占位值，真实值属 W0-5）
# 复制为 .env 使用；.env 已被 .gitignore 排除。
# 规则：任何密钥都不入库、不进镜像（技术选型 §6）。
# ⚠ 这里用 `MN_` 作应用侧前缀，同样是 master P1-20 未拍项（命名五条从未回写规格件）；
#   拍定后与本文件一起改，不要一半改一半留。

# --- 数据库 ---
# 开发期连共享 dev 机的映射端口，不在本机起有状态容器。
# ⚠ 2026-09-27 实测：172.16.70.100 当前不可达（ping 100% 丢包；30432/30090/30306 全部 TIMEOUT）。
#   开工 W0-5 前需确认机器是否在线、GameViewer 映射是否已启动、IP 是否变更。
PGHOST=172.16.70.100
PGPORT=30432
PGDATABASE=mn_dev
PGUSER=postgres
PGPASSWORD=
# 连接池设 10，不引入 pgbouncer（技术选型 §12.5）
PG_POOL_MAX=10
# 会话必须固定 UTC，否则编号日界与期限计算整体偏 8 小时（修订稿 §12.3）
PG_SESSION_TIMEZONE=UTC

# --- 对象存储（MinIO）---
MINIO_ENDPOINT=http://172.16.70.100:30090
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mn-attachments
# 预签名有效期：GET 60s；PUT 由上传流程另算（修订稿 §7.1）
MINIO_PRESIGN_GET_SECONDS=60

# --- 字段加密（两把密钥分离，修订稿 §6.3）---
MN_AES_KEY=
MN_HMAC_KEY=
MN_KEY_VERSION=1

# --- 云之家（口径：我方适配云之家，不改造平台）---
YZJ_APP_ID=
YZJ_APP_SECRET=
YZJ_REDIRECT_URI=
YZJ_STATE_SECRET=
# 域名必须在联调前定死：改域名要重走一次回调登记
PUBLIC_ORIGIN=

# --- Next 16 多副本必需（§13.3-3；一期若单副本可留空并注明）---
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
DEPLOYMENT_VERSION=

# --- 应用 ---
NODE_ENV=development
LOG_LEVEL=info
