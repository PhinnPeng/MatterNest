#!/bin/sh
#
# pre-commit：提交前跑全套门禁。
#
# 为什么需要它（2026-10-14，retro 候选 4①）：
#
# `pnpm verify` 已经覆盖 format / lint / typecheck / test / lint-guard /
# anchors / deploy:check 七道，但**只能靠人记得跑**。本轮我自己就在
# 「seed 改完没跑 db:check 就准备提交」上栽过一次 —— db:check 的 C14 是红的，
# 而 `pnpm verify` 是绿的，两件事在同一个提交里看起来都对。
#
# 这个 hook 把「提交前必须绿」从记忆变成机制。它**不替代** verify，
# 只是保证 verify 在提交那一刻一定跑过。
#
# 安装：`pnpm install` 时由 package.json 的 `prepare` 脚本复制进 .git/hooks/
#       （husky 的零依赖替代 —— 本仓没有也不需要那个依赖）。
#       已装过的机器跑一次 `pnpm prepare` 即可。
#
# 跳过：`git commit --no-verify`（保留这个逃生口 —— 门禁卡住时
#       要有办法绕，但绕的动作本身要留下痕迹）。
#
# ── 2026-10-16（MATT-92）：跑 verify 之前必须把 git 的「定位类变量」清掉 ──
#
# 这不是洁癖，是被咬出来的。git 会给**linked worktree 提交**的钩子注入
# `GIT_DIR` / `GIT_INDEX_FILE`（普通仓提交不注入 —— 实测对照过），而
# `tools/board-drift.spec.ts` 的临时仓夹具继承 `process.env`，于是它在
# 「临时目录」里跑的 init / config / commit 全部打到了**真仓**上：
#
#   · `git init` 带着显式 GIT_DIR ⇒ 把那个仓翻成 core.bare=true（实测：
#     正常 init 是 false，带 GIT_DIR 再 init 变 true）
#   · `git config user.email/user.name` ⇒ 写的是那个真仓的配置
#     （实测：真仓被改成 t <t@example.com>，临时目录里连 .git 都没建）
#   · `git commit --allow-empty` ⇒ 提交进真仓并再触发本钩子 ⇒ 自激循环
#     （每 ~13 秒一轮整套 verify，CPU 空转；22:18 那次 `invalid object …`
#     也是同一个泄漏在动真仓的 index）
#
# 所以下面先 unset，再跑 verify：门禁进程里不该有任何「指向某个仓」的变量。
# 这一条就是本次损伤的**止损点** —— 清掉之后，夹具的 init / config / commit
# 只可能落在它自己刚建的临时仓上。
#
# **没顺手改的一件事（在本票里明确不改）**：`dirname $0` 解析回的是**钩子文件
# 所在的树**，而 worktree 共享主仓的 `.git/hooks` —— 所以从 worktree 提交时，
# verify 跑的是**主树**，不是这棵树。它是上面那个循环的入口，但改动它 = 改
# 别人（原型 worktree）的提交流程：那棵树没有 node_modules，改完他们的提交
# 会当场失败。属于「要先问人」的范围，记在 MATT-92 票面，不在本次修复里。

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX \
      GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM \
      GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_NOSYSTEM

cd "$(dirname "$0")/../.." || exit 1

echo "pre-commit: 跑 pnpm verify …"
if pnpm verify; then
  exit 0
fi

cat <<'EOF'

pre-commit 拒绝提交：pnpm verify 未通过。

  · 先看输出里是哪一道红了，按提示修
  · 修完重跑 pnpm verify 确认全绿，再提交
  · 确实要绕过：git commit --no-verify（动作会留在 reflog 里）

注意：verify 不含 db:check 与全组冒烟 —— 它们要库。
      改了 seed / 迁移之后，额外跑一次：
        MN_DB_CONFIRM=dev_matternest pnpm db:check

EOF
exit 1
